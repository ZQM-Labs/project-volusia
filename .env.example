# Project Volusia - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# -- API Keys -----------------------------------------------------------------
# Get your free API keys from these services:
# Census: https://api.census.gov/data/key_signup.html
# BLS:    https://data.bls.gov/registrationEngine/
# BEA:    https://apps.bea.gov/API/signup/index.cfm

CENSUS_API_KEY=
BLS_API_KEY=
BEA_API_KEY=

# NOAA is free (no key required for NCEI public endpoints); set if you have
# a NOAA v2 Web Service token.
NOAA_API_KEY=

# -- Service Configuration ----------------------------------------------------
# Ports for the different services
VOLUSIA_PORTAL_HOST=127.0.0.1
VOLUSIA_PORTAL_PORT=8789
VOLUSIA_CONTRIBUTION_PORT=8790
VOLUSIA_CONTRIBUTE_PORT=8791

# Bind address for the portal (0.0.0.0 = all interfaces; production)
VOLUSIA_HOST=0.0.0.0

# Database path (relative to repo root)
VOLUSIA_DB_PATH=Tools/volusia_data/volusia.db

# -- Rate Limiting ------------------------------------------------------------
# Max requests per window per client for the contribution API (default: 10).
# Set VOLUSIA_RATE_LIMIT=0 to disable rate limiting.
VOLUSIA_RATE_LIMIT=10
# Sliding window in seconds (default: 60).
VOLUSIA_RATE_WINDOW=60

# -- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins for the portal API.
VOLUSIA_ALLOWED_ORIGINS=http://localhost:8789,http://127.0.0.1:8789

# -- Contribution API ---------------------------------------------------------
# Comma-separated list of allowed API keys (empty = anonymous allowed)
VOLUSIA_API_KEYS=

# Base URL of the contribution API used by portal_contribute.py.
# Leave EMPTY for same-origin mode (in-process fallback, no HTTP hop).
# Set e.g. http://127.0.0.1:8790 to force HTTP against a running API server.
VOLUSIA_CONTRIBUTION_API=

# -- Notifications / Governance -----------------------------------------------
# Public-facing email addresses surfaced in docs and reports.
CONTRIBUTION_EMAIL=contributions@zqmlabs.com
CGB_ADMIN_EMAIL=cgb@zqmlabs.com
EXTERNAL_SITE_URL=https://volusia.zqmlabs.com

# -- GitHub Integration -------------------------------------------------------
GITHUB_REPO=ZQM-Labs/project-volusia
# Optional PAT for CI/CD automation that needs write access (lower privilege
# than the Actions token is preferred).
GITHUB_TOKEN=

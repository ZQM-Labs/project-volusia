# Project Volusia — API Key Configuration
# ======================================
# Copy this file to .env and fill in the three keys.
# NEVER commit .env — it is listed in .gitignore for public repos.
#
# 1. Census Bureau API key
#    Signup: https://api.census.gov/data/key_signup.html
#    Email must end in .com / .net / .org / .gov / .edu
#    Key arrives by email; paste it here:
CENSUS_API_KEY=YOUR_CENSUS_API_KEY_HERE

# 2. Bureau of Labor Statistics API key (v2)
#    Signup: https://data.bls.gov/registrationEngine/
#    Enter email + organization name + CAPTCHA
#    Key arrives from labstat@bls.gov; paste it here:
BLS_API_KEY=YOUR_BLS_API_KEY_HERE

# 3. Bureau of Economic Analysis API UserId
#    Signup: https://apps.bea.gov/api/signup/
#    Name + email + agree to terms; returns 36-char UserId
#    UserId looks like: XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
#    Paste it here:
BEA_API_KEY=YOUR_BEA_API_KEY_HERE

# ── Optional ───────────────────────────────────────────────────────────
# Portal host/port (default 127.0.0.1:8789)
# VOLUSIA_PORTAL_HOST=127.0.0.1
# VOLUSIA_PORTAL_PORT=8789

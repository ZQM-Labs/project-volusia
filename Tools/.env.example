# Project Volusia — Environment Configuration
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git (it's in .gitignore)

# ── API Keys (free registration) ──────────────────────────────────
# Census ACS: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# BLS LAUS: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# BEA Regional: https://apps.bea.gov/API/signup/index.cfm
BEA_API_KEY=

# ── Service Configuration ──────────────────────────────────────────
VOLUSIA_PORTAL_HOST=127.0.0.1
VOLUSIA_PORTAL_PORT=8789
VOLUSIA_CONTRIBUTION_PORT=8790
VOLUSIA_CONTRIBUTE_PORT=8791

# ── Database ───────────────────────────────────────────────────────
VOLUSIA_DB_PATH=Tools/volusia_data/volusia.db

# ── GitHub ─────────────────────────────────────────────────────────
GITHUB_REPO=ZQM-Labs/project-volusia
